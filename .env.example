# groq = hosted open-weight models (fast) | ollama = fully local / offline
LLM_PROVIDER=groq

# Free key: https://console.groq.com
GROQ_API_KEY=
# Model names can change; check console.groq.com/docs/models if one fails
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# Offline mode
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
LOCAL_WHISPER_SIZE=small

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public URL from cloudflared (used in Telegram links and for phones)
PUBLIC_URL=http://localhost:8000

ALERT_RADIUS_KM=10
ROUTE_BUFFER_M=500
